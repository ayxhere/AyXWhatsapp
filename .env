# AyXWhatsapp — env (v269)
# ALL API endpoints + service config in ONE place. Nothing API-related is
# hardcoded in the code anymore — the app reads Env.kt (same values) and the
# on-device gateway (nodejs-project/main.js) reads these vars with the same
# defaults. Edit a URL here, then mirror it in Env.kt / main.js.
#
# SECRET KEYS ARE NEVER HERE. The user's own AI keys (Groq / OpenRouter /
# Gemini) are typed in the app's Settings and stored encrypted on-device
# (AiKeyStore). The gateway token is generated per install (GatewayAuth).
# Leave the key placeholders empty — do NOT paste a real key in this file,
# the repo is public.

# --- AI chat-completions endpoints (OpenAI-compatible) ---
AYX_GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
AYX_OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
AYX_GEMINI_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# --- Google Drive ---
AYX_DRIVE_API=https://www.googleapis.com/drive/v3
AYX_DRIVE_UPLOAD=https://www.googleapis.com/upload/drive/v3
AYX_DRIVE_SCOPE_FILE=https://www.googleapis.com/auth/drive.file

# --- Music search ---
AYX_JIOSAAVN_API=https://www.jiosaavn.com/api.php
AYX_JIOSAAVN_REFERER=https://www.jiosaavn.com/
AYX_ITUNES_SEARCH_API=https://itunes.apple.com/search
AYX_SPOTIFY_SEARCH_API=https://api.spotify.com/v1/search
AYX_SPOTIFY_EMBED_TRACK=https://open.spotify.com/embed/track/4uLU6hMCjMI75M1A2tKUQC

# --- Free AI fallbacks (gateway) ---
AYX_POLLINATIONS_VISION_URL=https://text.pollinations.ai/openai?referrer=ayxwhatsapp
AYX_POLLINATIONS_IMAGE_URL=https://image.pollinations.ai/prompt/
AYX_STREAMELEMENTS_TTS_URL=https://api.streamelements.com/kappa/v2/speech
AYX_GOOGLE_TTS_URL=https://translate.google.com/translate_tts
AYX_SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
AYX_LRCLIB_API=https://lrclib.net/api/get

# --- On-device gateway (Node server on localhost) ---
# Port lives in NodeRuntime.kt (PORT) + main.js (WAGW_PORT env). Host is fixed.
AYX_GATEWAY_HOST=127.0.0.1
AYX_GATEWAY_PORT=8765

# --- App / releases ---
AYX_DOWNLOAD_URL=https://github.com/ayxhere/AyXWhatsapp/releases/latest

# --- User's own AI keys (PLACEHOLDERS ONLY — never put a real key here) ---
# These are typed in the app's Settings, not read from this file.
AYX_GROQ_API_KEY=
AYX_OPENROUTER_API_KEY=
AYX_GEMINI_API_KEY=
