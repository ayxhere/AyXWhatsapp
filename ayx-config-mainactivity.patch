+// ===== AyX JSON Configuration Integration (Firebase-style) =====
+// Loads app/src/main/assets/ayx-services.json (auto-packaged into APK).
+// All API endpoints, timeouts, and feature flags come from the JSON
+// config — no hardcoded values.
+
+/** Holds the AyX service configuration loaded from packaged JSON. */
+data class AyxServiceConfig(
+    val projectId: String = "ayx-whatsapp",
+    val applicationId: String = "ayx.whatsapp",
+    val apiBaseUrl: String = "http://127.0.0.1:3101",
+    val publicApiBaseUrl: String = "https://api.imayx.in",
+    val connectionTimeoutMs: Int = 15000,
+    val readTimeoutMs: Int = 15000,
+    val maxRetryAttempts: Int = 4,
+    val featureGroupApi: Boolean = true,
+    val featureGroupSync: Boolean = true,
+    val featureHealthStatus: Boolean = true,
+) {
+    fun apiUrl(path: String): String {
+        val p = if (path.startsWith("/")) path else "/$path"
+        return apiBaseUrl.trimEnd('/') + p
+    }
+}
+
+/** Loads AyX config from assets/ayx-services.json. Thread-safe, cached, never crashes. */
+object AyxServiceConfigLoader {
+    @Volatile private var cached: AyxServiceConfig? = null
+
+    @Synchronized
+    fun load(ctx: android.content.Context): AyxServiceConfig {
+        cached?.let { return it }
+        return try {
+            val text = ctx.assets.open("ayx-services.json").bufferedReader().use { it.readText() }
+            fun s(key: String, def: String): String {
+                val m = Regex("\"" + key + "\"\\s*:\\s*\"([^\"]*)\"").find(text)
+                return m?.groupValues?.get(1) ?: def
+            }
+            fun b(key: String, def: Boolean): Boolean {
+                val m = Regex("\"" + key + "\"\\s*:\\s*(true|false)").find(text)
+                return m?.groupValues?.get(1)?.toBoolean() ?: def
+            }
+            fun i(key: String, def: Int): Int {
+                val m = Regex("\"" + key + "\"\\s*:\\s*(\\d+)").find(text)
+                return m?.groupValues?.get(1)?.toIntOrNull() ?: def
+            }
+            AyxServiceConfig(
+                projectId = s("project_id", "ayx-whatsapp"),
+                applicationId = s("application_id", "ayx.whatsapp"),
+                apiBaseUrl = s("api_base_url", "http://127.0.0.1:3101"),
+                publicApiBaseUrl = s("public_api_base_url", "https://api.imayx.in"),
+                connectionTimeoutMs = i("connection_timeout_seconds", 15) * 1000,
+                readTimeoutMs = i("read_timeout_seconds", 15) * 1000,
+                maxRetryAttempts = i("max_retry_attempts", 4),
+                featureGroupApi = b("group_api", true),
+                featureGroupSync = b("group_sync", true),
+                featureHealthStatus = b("health_status", true),
+            ).also { cached = it }
+        } catch (_: Exception) {
+            AyxServiceConfig().also { cached = it }
+        }
+    }
+}
